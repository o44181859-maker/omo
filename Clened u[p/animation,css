/* ================================
   Fade Animations
================================ */

.fade-in{
    animation:fadeIn 1s ease forwards;
}

@keyframes fadeIn{

0%{
opacity:0;
transform:translateY(40px);
}

100%{
opacity:1;
transform:translateY(0);
}

}

/* ================================
Floating Hearts
================================ */

.heart{

position:fixed;

bottom:-50px;

font-size:24px;

animation:floatUp linear forwards;

pointer-events:none;

opacity:.85;

}

@keyframes floatUp{

0%{

transform:
translateY(0)
scale(.6)
rotate(0deg);

opacity:0;

}

15%{

opacity:1;

}

100%{

transform:
translateY(-120vh)
scale(1.5)
rotate(360deg);

opacity:0;

}

}

/* ================================
Gift Cards
================================ */

.gift-card{

animation:popIn .7s ease backwards;

}

.gift-card:nth-child(1){animation-delay:.2s;}
.gift-card:nth-child(2){animation-delay:.35s;}
.gift-card:nth-child(3){animation-delay:.5s;}
.gift-card:nth-child(4){animation-delay:.65s;}
.gift-card:nth-child(5){animation-delay:.8s;}
.gift-card:nth-child(6){animation-delay:.95s;}
.gift-card:nth-child(7){animation-delay:1.1s;}
.gift-card:nth-child(8){animation-delay:1.25s;}

@keyframes popIn{

0%{

transform:
translateY(60px)
scale(.6);

opacity:0;

}

100%{

transform:
translateY(0)
scale(1);

opacity:1;

}

}

/* ================================
Button Pulse
================================ */

button{

animation:pulse 2.5s infinite;

}

@keyframes pulse{

0%,100%{

box-shadow:
0 0 0 0 rgba(255,82,140,.45);

}

70%{

box-shadow:
0 0 0 25px rgba(255,82,140,0);

}

}

/* ================================
Sparkles
================================ */

.sparkle{

position:fixed;

width:8px;
height:8px;

background:white;

border-radius:50%;

box-shadow:

0 0 20px white,
0 0 40px white;

animation:twinkle 3s infinite;

}

@keyframes twinkle{

0%,100%{

opacity:.1;
transform:scale(.3);

}

50%{

opacity:1;
transform:scale(1.3);

}

}